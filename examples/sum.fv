// A few primitive-typed exports composing into one component. Each
// is independently invocable via `wasmtime run --invoke`.

pub fn double(x: I32) -> I32 {
    x * 2
}

pub fn sum(a: I32, b: I32) -> I32 {
    a + b
}

pub fn factorial(n: I32) -> I32 {
    if n < 2 {
        1
    } else {
        n * factorial(n: n - 1)
    }
}
