// 07 — Recursion: deep self-call patterns.
// Targets: stack growth on plain recursion, mutual recursion (two functions
// calling each other), tail-position recursion, and a small Ackermann-style
// nested recursion as a stress case for type checking.

pub fn sum_to(n: I32) -> I32 {
    if n == 0 {
        0
    } else {
        n + sum_to(n: n - 1)
    }
}

// Mutual recursion: parity check without modulo.
pub fn is_even(n: I32) -> Boolean {
    if n == 0 {
        true
    } else {
        is_odd(n: n - 1)
    }
}

pub fn is_odd(n: I32) -> Boolean {
    if n == 0 {
        false
    } else {
        is_even(n: n - 1)
    }
}

// Ackermann, bounded by small arguments. Exercises the type checker's
// handling of nested recursive calls in a single expression.
pub fn ack(m: I32, n: I32) -> I32 {
    if m == 0 {
        n + 1
    } else {
        if n == 0 {
            ack(m: m - 1, n: 1)
        } else {
            ack(m: m - 1, n: ack(m: m, n: n - 1))
        }
    }
}

pub fn run_checks() {
    // 1 + 2 + 3 + 4 + 5 == 15
    assert(condition: sum_to(n: 5) == 15)
    assert(condition: is_even(n: 4))
    assert(condition: is_odd(n: 3))
    assert(condition: !is_even(n: 7))
    // ack(2, 2) == 7
    assert(condition: ack(m: 2, n: 2) == 7)
}
